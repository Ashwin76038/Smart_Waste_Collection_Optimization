ROW("Check", "CBE:modeled_spill_avoided_l", "Expected", 6.099452950148589, "Actual", CALCULATE([Modeled Spill Avoided L (24h)], dim_city[city_id]="CBE", dim_scenario[scenario]="base_3_trucks",fact_forecast_score[model]="ridge",fact_forecast_score[split]="test",fact_forecast_score[evaluation_group]="known_bins"), "Tolerance", 0.0000010000),
