// Reconciles executed Desktop DAX to independently calculated export values.
EVALUATE
VAR Checks = UNION(
ROW("Check", "CHN:bins", "Expected", 1000.0, "Actual", CALCULATE([Bin Count], dim_city[city_id]="CHN", dim_scenario[scenario]="base_3_trucks",fact_forecast_score[model]="ridge",fact_forecast_score[split]="test",fact_forecast_score[evaluation_group]="known_bins"), "Tolerance", 0.0000000100),
ROW("Check", "CHN:collected_kg", "Expected", 16150625.303025998, "Actual", CALCULATE(1000 * [Total Waste Collected (t)], dim_city[city_id]="CHN", dim_scenario[scenario]="base_3_trucks",fact_forecast_score[model]="ridge",fact_forecast_score[split]="test",fact_forecast_score[evaluation_group]="known_bins"), "Tolerance", 0.0100000000),
ROW("Check", "CHN:daily_collected_kg", "Expected", 16150625.673508286, "Actual", CALCULATE(SUM(fact_city_day[collected_kg]), dim_city[city_id]="CHN", dim_scenario[scenario]="base_3_trucks",fact_forecast_score[model]="ridge",fact_forecast_score[split]="test",fact_forecast_score[evaluation_group]="known_bins"), "Tolerance", 0.0100000000),
