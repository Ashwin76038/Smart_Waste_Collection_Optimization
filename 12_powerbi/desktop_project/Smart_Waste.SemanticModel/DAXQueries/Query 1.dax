ROW("Check", "CBE:daily_collected_kg", "Expected", 7301804.02697845, "Actual", CALCULATE(SUM(fact_city_day[collected_kg]), dim_city[city_id]="CBE", dim_scenario[scenario]="base_3_trucks",fact_forecast_score[model]="ridge",fact_forecast_score[split]="test",fact_forecast_score[evaluation_group]="known_bins"), "Tolerance", 0.0100000000),
