)
VAR Bad = FILTER(Checks, ISBLANK([Actual]) || ABS([Actual]-[Expected]) > [Tolerance])
RETURN ROW("Checks",COUNTROWS(Checks),"Passed",COUNTROWS(Checks)-COUNTROWS(Bad),"Failed",COUNTROWS(Bad),"Failed checks",CONCATENATEX(Bad,[Check],", "),"Maximum absolute difference",MAXX(Checks,ABS([Actual]-[Expected])))